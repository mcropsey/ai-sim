# ai-sim environment — edit values, keep this file next to ai_sim_server.py.
# Loaded by the systemd unit via EnvironmentFile, and also read directly by
# ai_sim_server.py when launched by hand (python3 ai_sim_server.py).

# Listen address.
AI_SIM_HOST=0.0.0.0

# TWO listeners, on purpose.
#
# The LLM/GenAI classifier accumulates score per API and emits ONE final
# classification. When both endpoint families shared a single host:port they
# were scored as one API, the text-generation signal won, and the GenAI tag
# never appeared. Serving them on separate ports makes them two distinct API
# entities that are scored independently.
#
# 8011 keeps it clear of the crAPI MCP box on 8009 (and 8000/8010 defaults).
#
# Keep comments on their own lines: systemd's EnvironmentFile does NOT strip
# trailing comments, so "AI_SIM_PORT=8011  # LLM" would be read as the literal
# string "8011  # LLM".
#
# LLM endpoints:
AI_SIM_PORT=8011
# GenAI endpoints:
AI_SIM_GENAI_PORT=8012

# Which listeners this process brings up: both | llm | genai
# Use 'llm' / 'genai' if you want to run them on two separate hosts.
AI_SIM_ROLE=both

# 1 = text-to-speech returns a JSON envelope carrying b64 audio plus explicit
#     media_type / mime_type fields. Sensors routinely classify raw binary
#     responses as ignored/unparseable traffic, which silently removed the TTS
#     endpoints from GenAI scoring. Keep this at 1 for the discovery demo.
# 0 = return real audio/mpeg bytes (byte-accurate, but often not classified).
AI_SIM_AUDIO_JSON=1

# Optional shared-secret gate. Leave BLANK for a discovery demo — the whole point
# is that the sensor can read the traffic. If set, every request must send
# Authorization: Bearer <value>  (and the traffic generator must match it).
# Note: with the gate on, vendor Authorization headers are suppressed by the
# generator, which weakens the vendor-pattern signal. Leave it off.
# AI_SIM_AUTH_TOKEN=
