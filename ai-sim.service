[Unit]
Description=AI-Sim Server (LLM :8011 + GenAI :8012 API simulator for sensor discovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aisim
Group=aisim
WorkingDirectory=/opt/ai-sim
EnvironmentFile=/opt/ai-sim/ai-sim.env
ExecStart=/opt/ai-sim/.venv/bin/python /opt/ai-sim/ai_sim_server.py
Restart=on-failure
RestartSec=3

# One process serves both listeners (AI_SIM_ROLE=both). To split them across two
# hosts, set AI_SIM_ROLE=llm on one box and AI_SIM_ROLE=genai on the other.

# Light hardening — fine for a lab.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
